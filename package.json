{
  "name": "cross-spawn",
  "version": "7.0.6",
  "description": "Cross platform child_process#spawn and child_process#spawnSync",
  "keywords": [
    "spawn",
    "spawnSync",
    "windows",
    "cross-platform",
    "path-ext",
    "shebang",
    "cmd",
    "execute"
  ],
  "author": "André Cruz <andre@moxy.studio>",
  "contributors": [
    {
      "email": "dimaslanjaka@gmail.com",
      "name": "Dimas Lanjaka",
      "url": "https://www.webmanajemen.com"
    }
  ],
  "homepage": "https://github.com/moxystudio/node-cross-spawn",
  "repository": {
    "type": "git",
    "url": "git@github.com:moxystudio/node-cross-spawn.git"
  },
  "license": "MIT",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "dist/lib",
    "dist/lib/util",
    "!package-lock.json",
    "!yarn.lock"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "update:packer": "curl -L https://github.com/dimaslanjaka/nodejs-package-types/raw/main/packer.js > packer.js",
    "update:ncu": "npx npm-check-updates -u -x jsdom,hexo,deepmerge-ts,chalk,eslint,eslint-plugin-jsdoc --enginesNode --root",
    "lint": "eslint --fix .",
    "test": "jest --env node --coverage --no-cache --runInBand",
    "pre-release": "npm t && npm run lint",
    "release": "standard-version",
    "clean": "npx -y rimraf tmp dist",
    "post-release": "git push --follow-tags origin HEAD && npm publish",
    "pack": "node packer.js",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --declarationDir dist --declaration --rootDir src",
    "build:js": "rollup -c",
    "build": "npm run build:types && npm run build:js",
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "glob": "^11.0.0",
    "shebang-command": "^2.0.0",
    "which": "^3.0.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.7",
    "@babel/core": "^7.25.7",
    "@babel/plugin-syntax-import-assertions": "^7.28.6",
    "@babel/preset-env": "^7.25.7",
    "@babel/preset-typescript": "^7.25.7",
    "@commitlint/cli": "^17.6.5",
    "@commitlint/config-conventional": "^17.6.5",
    "@dimaslanjaka/eslint-base-config": "^1.0.2",
    "@jest/globals": "^29.5.0",
    "@moxy/babel-preset": "^3.3.2",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "binary-collections": "^2.0.15",
    "cross-spawn": "https://github.com/dimaslanjaka/node-cross-spawn/raw/78b09a1f799430fb251c1b438ec56ce7957674f4/release/cross-spawn.tgz",
    "fs-extra": "^11.1.1",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "jsonc-parser": "3.3.1",
    "lint-staged": "^17.0.5",
    "minimist": "^1.2.8",
    "mkdirp": "^3.0.1",
    "prettier": "3.8.3",
    "rimraf": "^5.0.10",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "upath": "^2.0.1"
  },
  "engines": {
    "node": ">= 8"
  },
  "overrides": {
    "deepmerge-ts": "^4"
  },
  "packageManager": "yarn@4.13.0",
  "resolutions": {
    "@dimaslanjaka/eslint-base-config": "https://github.com/dimaslanjaka/eslint-base-config/raw/822b872f18985462f0da358579cd6493472a2ee0/release/dimaslanjaka-eslint-base-config.tgz",
    "cross-spawn": "https://github.com/dimaslanjaka/node-cross-spawn/raw/92032267c3f74f1092a7794c178720af94dff3d8/release/cross-spawn.tgz",
    "binary-collections": "https://github.com/dimaslanjaka/bin/raw/1a89c5c147211e6e2294c447c201356f17e028dd/releases/bin.tgz",
    "git-command-helper": "https://github.com/dimaslanjaka/git-command-helper/raw/1fdf12be05b24af9a7c804033e1ce9cbcfefa1b0/release/git-command-helper.tgz",
    "sbg-utility": "https://github.com/dimaslanjaka/static-blog-generator/raw/44e5c7b79b4e60f8c2d34857c27b8ce677d7493e/packages/sbg-utility/release/sbg-utility.tgz"
  }
}
